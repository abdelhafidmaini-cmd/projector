<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#133330" />
            <stroke android:width="2.5dp" android:color="#34D399" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#102C2A" android:endColor="#0D1F24" />
            <stroke android:width="1.2dp" android:color="#10B981" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
