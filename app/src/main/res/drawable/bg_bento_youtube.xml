<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#331542" />
            <stroke android:width="2.5dp" android:color="#E879F9" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#291238" android:endColor="#170E28" />
            <stroke android:width="1.2dp" android:color="#C026D3" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
