<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E204D" />
            <stroke android:width="2.5dp" android:color="#22D3EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#1B1B42" android:endColor="#11132E" />
            <stroke android:width="1.2dp" android:color="#8B5CF6" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
