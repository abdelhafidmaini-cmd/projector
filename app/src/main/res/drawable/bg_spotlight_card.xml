<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0C4A6E"
                android:centerColor="#075985"
                android:endColor="#1E1B4B" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#082F49"
                android:centerColor="#0C4A6E"
                android:endColor="#172554" />
            <stroke android:width="1.5dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
